# DashScope / 百炼 API Key（OCR 和底图净化均需要）
DASHSCOPE_API_KEY=
DASHSCOPE_OCR_API_KEY=
DASHSCOPE_OCR_MODEL=qwen3.5-ocr
DASHSCOPE_OCR_BASE_URL=https://your-workspace-host.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 可选：通常会由上面的兼容端点自动推导为同一工作空间的 /api/v1。
# DASHSCOPE_OCR_NATIVE_BASE_URL=https://your-workspace-host.cn-beijing.maas.aliyuncs.com/api/v1

# OCR / 版式识别模型
DASHSCOPE_VISION_MODEL=qwen3-vl-plus

# 图像编辑模型。若您的百炼工作空间要求专属端点，请填写它；否则使用默认 DashScope 端点。
DASHSCOPE_IMAGE_EDIT_MODEL=qwen-image-2.0-pro
# DASHSCOPE_IMAGE_EDIT_ENDPOINT=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Local strict batch runtime
PPT_API_SECRET=
SKILL_MERGE_DATA_ROOT=
SKILL_MERGE_POWERPOINT_PATH=C:\Program Files\Microsoft Office\root\Office16\POWERPNT.EXE
# Optional explicit Python interpreter used by the local QA/vision tools.
SKILL_MERGE_PYTHON_PATH=
SKILL_MERGE_QWEN_IMAGE_MAX_ASSETS=6

# 可选：部署时的接口共享密钥
# PPT_API_SECRET=
